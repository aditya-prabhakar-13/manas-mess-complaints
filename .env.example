# Manas Hostel Mess Complaint Portal — Environment Configuration
# Copy this file to .env.local for local development, and configure these variables in Vercel.

# ─────────────────────────────────────────────────────────────
# 1. DATABASE (Neon Serverless Postgres)
# ─────────────────────────────────────────────────────────────
# Neon pooled connection string with SSL required.
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────
# 2. JWT SESSION SECRET
# ─────────────────────────────────────────────────────────────
# 256-bit cryptographic secret key (64-character hex string).
# Generate using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_character_cryptographic_random_hex_string

# ─────────────────────────────────────────────────────────────
# 3. SUPER ADMIN CREDENTIALS (Auto-bootstrapped on demand)
# ─────────────────────────────────────────────────────────────
# Super admin account credentials for hostel administrators.
# Upon first login at /admin/login, these credentials bootstrap the super admin account.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=replace_with_strong_administrative_password

# ─────────────────────────────────────────────────────────────
# 4. APP CONFIGURATION & PORTAL ADDRESS
# ─────────────────────────────────────────────────────────────
NODE_ENV=production

# Public canonical URL of the deployed portal (used for printable QR code vector generation)
NEXT_PUBLIC_APP_URL=https://manas-mess.vercel.app
NEXT_PUBLIC_SITE_URL=https://manas-mess.vercel.app
