# Manas Hostel Mess Complaint Portal — Environment Variables
# Copy this file to .env.local and fill in the values.

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
# Neon serverless Postgres connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────
# JWT SESSION SECRET
# ─────────────────────────────────────────
# 64-character random hex string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex_string

# ─────────────────────────────────────────
# SUPER ADMIN CREDENTIALS (seeded on first run)
# ─────────────────────────────────────────
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=replace_with_strong_password

# ─────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────
NODE_ENV=development

# The public URL of the site (used for QR code generation)
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app
